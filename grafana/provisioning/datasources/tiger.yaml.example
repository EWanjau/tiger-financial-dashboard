apiVersion: 1

datasources:
  - name: Tiger Cloud
    uid: tiger-cloud
    type: postgres
    access: proxy
    isDefault: true
    url: YOUR_HOST:35186
    user: tsdbadmin
    editable: true
    jsonData:
      database: tsdb
      sslmode: require
      postgresVersion: 1600
      timescaledb: true
    secureJsonData:
      password: YOUR_PASSWORD
