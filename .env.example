# Twelve Data (either name works)
TWELVE_DATA_API_KEY=your_twelve_data_api_key
TWELVEDATA_API_KEY=your_twelve_data_api_key

# Tiger Cloud (either name works)
TigerDataConnectionString=postgres://tsdbadmin:password@host:35186/tsdb?sslmode=require
DATABASE_URL=postgres://tsdbadmin:password@host:35186/tsdb?sslmode=require

# Optional explicit Grafana datasource fields (filled by: python -m ingest.provision_grafana)
TIGER_HOST=
TIGER_PORT=35186
TIGER_USER=tsdbadmin
TIGER_PASSWORD=
TIGER_DB=tsdb

# Ingest
SYMBOLS=BTC/USD,ETH/USD,SOL/USD,AAPL,MSFT
BACKFILL_INTERVAL=1min
BACKFILL_OUTPUTSIZE=500
BATCH_SIZE=50
